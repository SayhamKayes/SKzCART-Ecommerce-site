# =========================================================
# AmarDokan Frontend Environment Template (.env.example)
# =========================================================

# Backend API Base URL
# Local development: Leave empty (Vite proxies /api to http://127.0.0.1:8000) or set explicitly
VITE_API_BASE_URL=

# Live Production Server Options:
# Option A (Reverse Proxy / Nginx same domain): Leave empty ""
# Option B (Separate Subdomain): VITE_API_BASE_URL=https://api.yourdomain.com

# Front Panel & Theme Customizer Authentication (/front-panel)
VITE_FRONT_PANEL_USER=admin
VITE_FRONT_PANEL_PASS=your_front_panel_password

# Operations Admin Command Center Authentication (/admin) - Role: ADMIN
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=your_admin_password

# Operations Manager Authentication (/admin) - Role: MANAGER
VITE_MANAGER_USER=manager
VITE_MANAGER_PASS=your_manager_password

# Logistics Dispatcher Authentication (/admin) - Role: DISPATCHER
VITE_DISPATCHER_USER=dispatcher
VITE_DISPATCHER_PASS=your_dispatcher_password

# Courier / Rider Delivery Hub PIN Code (/courier)
VITE_COURIER_RIDER_PIN=1234

# Courier Gateway API Credentials (Frontend Fallback)
VITE_STEADFAST_API_KEY=
VITE_STEADFAST_SECRET_KEY=
VITE_REDX_API_TOKEN=
VITE_REDX_SECRET_KEY=
VITE_ECOURIER_API_KEY=
VITE_ECOURIER_SECRET_KEY=
